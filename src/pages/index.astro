---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { optimizeCloudinaryUrl, formatEditorialDate, getReadingTime, getCategorySlug } from '../utils/cloudinary';

const allNoticias = await getCollection('noticias');
const sortedNoticias = allNoticias.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Breaking / Trending highlight item
const breakingArticle = sortedNoticias.slice(0, 5).find((n) => n.data.breaking) || sortedNoticias[0];

// Main Hero Article
const heroArticle = sortedNoticias.slice(0, 3).find((n) => n.data.featured) || sortedNoticias[0];

// Sub-hero pair
const remainingAfterHero = sortedNoticias.filter((n) => n.id !== heroArticle.id);
const heroSubArticles = remainingAfterHero.slice(0, 2);

// Right sidebar stories ("Imperdibles de Palenque")
const secondaryTopArticles = remainingAfterHero.slice(2, 6);

const topUsedIds = new Set([
  heroArticle.id,
  ...heroSubArticles.map((a) => a.id),
  ...secondaryTopArticles.map((a) => a.id),
]);

// Cascadas & Naturaleza strip
const cascadasArticles = sortedNoticias
  .filter((n) => !topUsedIds.has(n.id) && n.data.category === 'Cascadas y Naturaleza')
  .slice(0, 3);
cascadasArticles.forEach((a) => topUsedIds.add(a.id));

// Zona Maya strip
const zonaMayaArticles = sortedNoticias
  .filter((n) => !topUsedIds.has(n.id) && n.data.category === 'Zona Maya y Cultura')
  .slice(0, 3);
zonaMayaArticles.forEach((a) => topUsedIds.add(a.id));

// General feed
const feedArticles = sortedNoticias.filter((n) => !topUsedIds.has(n.id)).slice(0, 15);

const heroImageOptimized = optimizeCloudinaryUrl(heroArticle.data.image, {
  width: 1200,
  height: 675,
  crop: 'fill',
});

const heroCategorySlug = getCategorySlug(heroArticle.data.category);
---

<BaseLayout currentCategory="Portada">
  <!-- Breaking / Alert Banner -->
  {breakingArticle && (
    <div class="breaking-bar">
      <div class="container-editorial breaking-inner">
        <span class="breaking-badge">
          <span class="live-pulse-dot" aria-hidden="true"></span>
          DESTACADO EN PALENQUE
        </span>
        <a href={`/noticias/${breakingArticle.id}`} class="breaking-link">
          {breakingArticle.data.title}
        </a>
      </div>
    </div>
  )}

  <div class="container-editorial main-portal-wrap">
    <!-- Hero Grid: Main Story + Right Column -->
    <section class="hero-editorial-grid" aria-label="Guías y Reportajes Principales">
      <article class="hero-main-story">
        <a href={`/noticias/${heroArticle.id}`} class="hero-media-link">
          <div class="hero-image-frame">
            <img
              src={heroImageOptimized}
              alt={heroArticle.data.title}
              width="1200"
              height="675"
              fetchpriority="high"
              class="hero-img"
            />
          </div>
          {heroArticle.data.imageCaption && (
            <span class="hero-caption">{heroArticle.data.imageCaption}</span>
          )}
        </a>

        <div class="hero-content">
          <a href={`/categoria/${heroCategorySlug}`} class="badge-category">
            {heroArticle.data.category}
          </a>

          <h1 class="headline-hero">
            <a href={`/noticias/${heroArticle.id}`} class="hero-title-link">
              {heroArticle.data.title}
            </a>
          </h1>

          {heroArticle.data.excerpt && (
            <p class="hero-excerpt">{heroArticle.data.excerpt}</p>
          )}

          <div class="hero-meta">
            <span class="meta-author">Por {heroArticle.data.author}</span>
            <span>·</span>
            <time datetime={heroArticle.data.pubDate.toISOString()}>
              {formatEditorialDate(heroArticle.data.pubDate)}
            </time>
            <span>·</span>
            <span>Lectura de {getReadingTime(heroArticle.body)} min</span>
          </div>
        </div>

        {heroSubArticles.length > 0 && (
          <div class="hero-sub-grid">
            {heroSubArticles.map((subArticle) => (
              <NewsCard article={subArticle} variant="default" />
            ))}
          </div>
        )}
      </article>

      <!-- Right Column: Imperdibles + Tourist Assistance Card -->
      <aside class="hero-side-column" aria-label="Lo más leído de Palenque">
        <div class="side-column-header">
          <span class="badge-category-solid">🌿 Imperdibles de Palenque</span>
        </div>
        <div class="side-stories-stack">
          {secondaryTopArticles.map((article, idx) => (
            <NewsCard article={article} variant={idx === 0 ? 'default' : 'compact'} />
          ))}
        </div>

        <!-- Tourist Box -->
        <div class="citizen-alert-card">
          <div class="citizen-alert-header">
            <span class="citizen-icon">🗺️</span>
            <strong>¿Planeas tu viaje a Palenque?</strong>
          </div>
          <p>
            Revisa nuestras guías de 3 días, tips de cómo llegar desde San Cristóbal o Villahermosa y las mejores cabañas con alberca.
          </p>
          <a href="/categoria/guia-del-viajero" class="citizen-btn">
            Ver Guía Completa de Viaje →
          </a>
        </div>
      </aside>
    </section>

    <!-- Cascadas y Naturaleza Strip -->
    {cascadasArticles.length > 0 && (
      <section class="editorial-section deferred-editorial-section" aria-label="Cascadas y Naturaleza">
        <div class="section-header-editorial">
          <h2 class="section-title-editorial">💧 Cascadas de Chiapas: Agua Azul, Misol-Ha y Roberto Barrios</h2>
          <a href="/categoria/cascadas-y-naturaleza" class="section-link-more">Ver todas las cascadas →</a>
        </div>
        <div class="three-col-grid">
          {cascadasArticles.map((article) => (
            <NewsCard article={article} variant="default" />
          ))}
        </div>
      </section>
    )}

    <!-- Zona Maya y Cultura Strip -->
    {zonaMayaArticles.length > 0 && (
      <section class="editorial-section deferred-editorial-section" aria-label="Zona Maya y Cultura">
        <div class="section-header-editorial">
          <h2 class="section-title-editorial">🏛️ Zona Arqueológica, Pakal y Misterios Mayas</h2>
          <a href="/categoria/zona-maya-y-cultura" class="section-link-more">Explorar historia maya →</a>
        </div>
        <div class="three-col-grid">
          {zonaMayaArticles.map((article) => (
            <NewsCard article={article} variant="default" />
          ))}
        </div>
      </section>
    )}

    <!-- More Articles Feed -->
    <section class="editorial-section deferred-editorial-section" aria-label="Explora Palenque al Máximo">
      <div class="section-header-editorial">
        <h2 class="section-title-editorial">🎒 Aventuras, Gastronomía y Hospedaje en Palenque</h2>
        <a href="/categoria/gastronomia" class="section-link-more">Dónde comer →</a>
      </div>

      <div class="three-col-grid">
        {feedArticles.map((article) => (
          <NewsCard article={article} variant="default" />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .breaking-bar {
    background-color: var(--color-brand-primary-light);
    border-bottom: 1px solid rgba(0, 122, 248, 0.25);
    padding: 0.55rem 0;
  }

  .breaking-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  .breaking-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background-color: var(--color-brand-navy);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.24rem 0.65rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .breaking-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-brand-navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .breaking-link:hover {
    color: var(--color-brand-primary-dark);
  }

  .main-portal-wrap {
    padding-top: 1.5rem;
  }

  .hero-editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--color-brand-primary);
    margin-bottom: 2.5rem;
  }

  @media (min-width: 1024px) {
    .hero-editorial-grid {
      grid-template-columns: 1.75fr 1fr;
      gap: 2.5rem;
    }
  }

  .hero-main-story {
    display: flex;
    flex-direction: column;
  }

  .hero-media-link {
    display: block;
    margin-bottom: 1rem;
  }

  .hero-image-frame {
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--color-mist);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .hero-main-story:hover .hero-img {
    transform: scale(1.02);
  }

  .hero-caption {
    display: block;
    font-size: 0.75rem;
    color: var(--color-brand-slate);
    margin-top: 0.4rem;
  }

  .hero-title-link:hover {
    color: var(--color-brand-primary);
  }

  .hero-excerpt {
    font-size: 1.04rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 1rem 0;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--color-brand-slate);
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
  }

  .meta-author {
    font-weight: 700;
    color: var(--color-brand-navy);
  }

  .hero-sub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .hero-sub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hero-side-column {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .hero-side-column {
      border-top: none;
      padding-top: 0;
      border-left: 1px solid var(--color-border);
      padding-left: 2rem;
    }
  }

  .side-column-header {
    margin-bottom: 1.25rem;
  }

  .side-stories-stack {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .citizen-alert-card {
    margin-top: 1.75rem;
    padding: 1.15rem 1.25rem;
    background: linear-gradient(135deg, #ebf4ff 0%, #f8fafc 100%);
    border: 1px solid rgba(0, 122, 248, 0.35);
    border-left: 4px solid var(--color-brand-primary);
    border-radius: var(--radius-sm);
  }

  .citizen-alert-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--color-brand-navy);
    margin-bottom: 0.4rem;
  }

  .citizen-alert-card p {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-brand-slate);
    margin: 0 0 0.85rem 0;
  }

  .citizen-btn {
    display: inline-block;
    background-color: var(--color-brand-primary);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    transition: background-color 0.15s ease;
  }

  .citizen-btn:hover {
    background-color: var(--color-brand-navy);
    color: #ffffff;
  }

  .editorial-section {
    margin-bottom: 3rem;
  }

  .three-col-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .three-col-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .three-col-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
