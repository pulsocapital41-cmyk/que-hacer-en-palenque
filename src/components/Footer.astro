---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-editorial footer-grid">
    <div class="footer-brand-col">
      <a href="/" class="footer-logo-link">
        <img
          src="/logo-white.png"
          alt="¿Qué hacer en Palenque?"
          class="footer-logo-img"
          width="400"
          height="160"
          loading="lazy"
        />
      </a>
      <p class="footer-mission">
        La guía turística y ciudadana más completa de Palenque, Chiapas. Aventuras de un viajero: ruinas mayas, cascadas de agua turquesa, selva lacandona, gastronomía y los mejores rincones de Chiapas.
      </p>
      <p class="footer-contact-note">
        <strong>Contacto & Redacción:</strong> contacto@quehacerenpalenque.com · redaccion@quehacerenpalenque.com
      </p>
      <div class="footer-cloudinary-badge">
        <span>Imágenes optimizadas vía</span>
        <strong>Cloudinary CDN & WebP</strong>
      </div>
    </div>

    <div class="footer-links-col">
      <h4 class="footer-col-title">Secciones de Palenque</h4>
      <ul class="footer-nav-list">
        <li><a href="/">Portada</a></li>
        <li><a href="/categoria/zona-maya-y-cultura">Zona Maya y Cultura</a></li>
        <li><a href="/categoria/cascadas-y-naturaleza">Cascadas y Naturaleza</a></li>
        <li><a href="/categoria/gastronomia">Gastronomía</a></li>
        <li><a href="/categoria/hospedaje">Hospedaje</a></li>
        <li><a href="/categoria/guia-del-viajero">Guía del Viajero</a></li>
        <li><a href="/categoria/comunidad-y-eventos">Comunidad y Eventos</a></li>
        <li>
          <a href="https://central.neuronamedios.com" target="_blank" rel="noopener noreferrer">
            Central Editorial →
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container-editorial footer-bottom-inner">
      <p>© {currentYear} <strong>¿Qué hacer en Palenque?</strong> (quehacerenpalenque.com). Todos los derechos reservados.</p>
      <p class="footer-tech">Portal Editorial de Alta Velocidad · Mobile-First · Chiapas, México</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-brand-navy);
    color: #cbd5e1;
    margin-top: 4rem;
    border-top: 4px solid var(--color-brand-primary);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    height: 48px;
    width: auto;
  }

  .footer-mission {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #94a3b8;
    max-width: 46ch;
    margin: 0 0 0.75rem 0;
  }

  .footer-contact-note {
    margin: 0 0 1rem 0;
    font-size: 0.84rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  .footer-contact-note strong {
    color: #ffffff;
  }

  .footer-cloudinary-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    background: rgba(0, 122, 248, 0.16);
    border: 1px solid rgba(0, 122, 248, 0.45);
    color: #e2e8f0;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
  }

  .footer-cloudinary-badge strong {
    color: #38bdf8;
  }

  .footer-col-title {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin: 0 0 1rem 0;
    border-left: 3px solid var(--color-brand-primary);
    padding-left: 0.6rem;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.55rem;
    font-size: 0.9rem;
  }

  .footer-nav-list a:hover {
    color: #38bdf8;
  }

  .footer-bottom {
    background-color: var(--color-brand-navy-dark);
    padding: 1.15rem 0;
    font-size: 0.78rem;
    color: #64748b;
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    justify-content: space-between;
  }

  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom strong {
    color: #cbd5e1;
  }
</style>
